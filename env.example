# Email configuration for contact form using Resend
# Resend is a modern email API service with a free tier (3,000 emails/month, 100/day)
# 
# Setup Instructions:
# 1. Sign up for a free account at https://resend.com
# 2. Get your API key from https://resend.com/api-keys
# 3. Add and verify your domain (or use the default onboarding@resend.dev for testing)
# 4. Copy your API key and add it below

# Resend API Configuration
RESEND_API_KEY="re_your_api_key_here"

# Email addresses
# RESEND_FROM_EMAIL: The verified sender email address (default: onboarding@resend.dev for testing)
# CONTACT_TO_EMAIL: Where you want to receive contact form inquiries
RESEND_FROM_EMAIL="onboarding@resend.dev"
CONTACT_TO_EMAIL="your-email@example.com"

