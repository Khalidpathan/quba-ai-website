# Email configuration for contact form
# For Gmail, create an App Password and use your Gmail address as EMAIL_USER and EMAIL_FROM.
# CONTACT_TO is where you want to receive enquiries.

# SMTP (Gmail)
EMAIL_USER="your_gmail_address@example.com"
EMAIL_PASS="your_gmail_app_password"

# Message addressing
EMAIL_FROM="your_gmail_address@example.com"
CONTACT_TO="recipient@example.com"

